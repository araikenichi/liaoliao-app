rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isValidUser(user) {
      return user.keys().hasAll(['email', 'displayName', 'age', 'gender']) &&
             user.age is number && user.age >= 18 && user.age <= 100 &&
             user.gender in ['male', 'female', 'other'] &&
             user.displayName is string && user.displayName.size() > 0 &&
             user.email is string && user.email.matches('.*@.*\\..*');
    }

    // Users collection
    match /users/{userId} {
      // Anyone can read basic user profiles (for matching)
      allow read: if isSignedIn();

      // Users can only create/update their own profile
      allow create: if isSignedIn() &&
                      isOwner(userId) &&
                      isValidUser(request.resource.data);

      allow update: if isSignedIn() &&
                      isOwner(userId) &&
                      isValidUser(request.resource.data);

      // Users can delete their own profile
      allow delete: if isSignedIn() && isOwner(userId);
    }

    // Conversations collection
    match /conversations/{conversationId} {
      // Only participants can read the conversation
      allow read: if isSignedIn() &&
                    request.auth.uid in resource.data.participants;

      // Create conversation if user is a participant
      allow create: if isSignedIn() &&
                      request.auth.uid in request.resource.data.participants &&
                      request.resource.data.participants.size() == 2;

      // Update conversation if user is a participant
      allow update: if isSignedIn() &&
                      request.auth.uid in resource.data.participants;

      // No deletion of conversations (for data integrity)
      allow delete: if false;
    }

    // Matches collection
    match /matches/{matchId} {
      // Users can read their own matches
      allow read: if isSignedIn() &&
                    (request.auth.uid == resource.data.userA ||
                     request.auth.uid == resource.data.userB);

      // System creates matches (through Cloud Functions)
      allow create: if false;

      // Users can update match status
      allow update: if isSignedIn() &&
                      (request.auth.uid == resource.data.userA ||
                       request.auth.uid == resource.data.userB) &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['status', 'updatedAt']);

      allow delete: if false;
    }

    // AI Memory collection (private user data)
    match /ai_memory/{userId} {
      allow read: if isSignedIn() && isOwner(userId);
      allow write: if false; // Only Cloud Functions can write
    }

    // Analytics collection (write-only for logging)
    match /analytics/{document=**} {
      allow read: if false; // Only backend can read
      allow write: if isSignedIn(); // Users can log events
    }
  }
}
